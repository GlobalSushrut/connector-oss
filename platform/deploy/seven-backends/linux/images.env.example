# No defaults are intentional. Use immutable image references containing @sha256:.
POSTGRES_IMAGE=
KEYCLOAK_IMAGE=
OTEL_COLLECTOR_IMAGE=

KEYCLOAK_DB_PASSWORD=
KEYCLOAK_ADMIN=
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_HOSTNAME=
KEYCLOAK_HTTPS_PORT=8443
KEYCLOAK_TLS_DIR=

# Used by bootstrap-keycloak.sh. Must match Connector's callback route.
CONNECTOR_SSO_CLIENT_ID=connector-platform
CONNECTOR_SSO_CLIENT_SECRET=
CONNECTOR_SSO_REDIRECT_URI=https://connector.example/api/v1/auth/sso/callback
