[Unit]
Description=Connector-operated SPIRE server
Documentation=https://spiffe.io/docs/latest/deploying/spire_server/
After=network-online.target
Wants=network-online.target
Before=connector-spire-agent.service connector-platform.service

[Service]
Type=simple
User=spire-server
Group=spire-server
ExecStart=/usr/local/bin/spire-server run -config /etc/connector/seven-backends/spire/server.conf
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/spire/server /run/spire/server
RuntimeDirectory=spire/server
StateDirectory=spire/server

[Install]
WantedBy=multi-user.target
