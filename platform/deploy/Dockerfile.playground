# Connector OS — Playground image (minimal context; see dockerignore.playground)
#
#   make -C platform/ui-leptos build-dashboard   # optional UI
#   fly deploy -c platform/deploy/fly.playground.toml .

FROM rust:1.88-slim-bookworm AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler pkg-config libssl-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY platform/server ./platform/server
COPY platform/supervisor ./platform/supervisor
COPY platform/cpkg ./platform/cpkg
COPY platform/plugin-manifest ./platform/plugin-manifest
COPY platform/plugin-handshake ./platform/plugin-handshake
COPY platform/plugin-runtime ./platform/plugin-runtime
COPY platform/microvm ./platform/microvm
COPY oss/vac/Cargo.toml ./oss/vac/Cargo.toml
COPY oss/vac/crates ./oss/vac/crates
COPY oss/connector/Cargo.toml ./oss/connector/Cargo.toml
COPY oss/connector/crates ./oss/connector/crates
COPY oss/aapi/Cargo.toml ./oss/aapi/Cargo.toml
COPY oss/aapi/crates ./oss/aapi/crates
COPY agos-abi ./agos-abi
COPY agos-sdk ./agos-sdk

# Depot builders OOM on release (LTO + codegen-units=1); use profile.docker
ENV CARGO_BUILD_JOBS=1
RUN cd platform/server && cargo build --profile docker --locked --bin connector-platform

FROM debian:bookworm-slim AS runtime

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

RUN useradd -r -s /usr/sbin/nologin -d /var/lib/connector -m connector

COPY --from=builder /build/platform/server/target/docker/connector-platform \
    /usr/local/bin/connector-platform
RUN chmod 755 /usr/local/bin/connector-platform

RUN mkdir -p /var/lib/connector/ui && chown -R connector:connector /var/lib/connector

USER connector
WORKDIR /var/lib/connector

ENV CONNECTOR_PRESET=playground \
    CONNECTOR_HOST=0.0.0.0 \
    CONNECTOR_PORT=8080 \
    CONNECTOR_DATA_DIR=/var/lib/connector \
    CONNECTOR_UI_DIR=/var/lib/connector/ui \
    RUST_LOG=info

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -sf http://localhost:8080/health || exit 1

ENTRYPOINT ["/usr/local/bin/connector-platform"]
