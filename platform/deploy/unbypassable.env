# Connector OS — unbypassable / defense-strict host profile (Seven Pillars).
# Usage:
#   set -a && source platform/deploy/unbypassable.env && set +a
#   export CONNECTOR_PRESET=defense-strict   # or unbypassable (alias)
#
# Do NOT set break-glass flags: CONNECTOR_ALLOW_IN_PROCESS_EFFECTS,
# CONNECTOR_ALLOW_UNAUTH_VSOCK, CONNECTOR_ALLOW_ISOLATION_DOWNGRADE.

CONNECTOR_PRESET=defense-strict
CONNECTOR_ENV=production
CONNECTOR_DEFENSE_STRICT=1

# Master bar
CONNECTOR_SANDBOX_UNBYPASSABLE=1
CONNECTOR_EFFECT_EXCLUSIVITY=1
CONNECTOR_KERNEL_ENFORCE=1
CONNECTOR_KERNEL_FAIL_CLOSED=1
CONNECTOR_FLOW_LEASE_ENFORCE=1

# Identity / LLM
CONNECTOR_IIA_RING1=1
CONNECTOR_IIA_QPR_ENFORCE=1
CONNECTOR_IIA_DOCKLOCK_ENFORCE=1
CONNECTOR_IIA_HITL_ENFORCE=1
CONNECTOR_AGENT_SETUP_GATE=1
CONNECTOR_GATEWAY_BAN_ANON=1
CONNECTOR_LLM_DISTRUST=1
CONNECTOR_AGENTIC_CONTEXT_REQUIRE=1
CONNECTOR_ZT_HANDSHAKE=1
CONNECTOR_PACKET_DNA_REQUIRE=1
# Prefer: export CONNECTOR_PACKET_DNA_HMAC="$(openssl rand -hex 32)"

# FS
CONNECTOR_DOCKLOCK_LANDLOCK_FAIL_CLOSED=1
CONNECTOR_DOCKLOCK_FS_READ=./data/nsfs
CONNECTOR_DOCKLOCK_FS_WRITE=./data/nsfs

# Net
CONNECTOR_L7_EGRESS_PROXY=1
CONNECTOR_MCP_EGRESS_ENFORCE=1
CONNECTOR_MATRIX_HW_ENFORCE=1
CONNECTOR_MATRIX_HOST_EGRESS=1
CONNECTOR_EBPF_REQUIRE=1
CONNECTOR_PEER_OVERLAY=1
CONNECTOR_EBPF_OBJ=platform/ebpf/connector_mark_deny.bpf.o
CONNECTOR_EBPF_PIN_ROOT=/sys/fs/bpf/connector

# Isolation / VM
CONNECTOR_ISOLATION_RUNTIME=microvm
CONNECTOR_PLUGIN_RUN_BACKEND=microvm
CONNECTOR_TOOLS_IN_MICROVM=1
CONNECTOR_WORLD_CHANNEL_VIA_MICROVM=1
CONNECTOR_MICROVM_EGRESS_MODE=deny_all
CONNECTOR_DOCKER_LAB_EGRESS=deny_all
CONNECTOR_VSOCK_TICKET_REQUIRE=1
# T7 — out-of-process MCP default (no host broker)
CONNECTOR_TOOLS_IN_MICROVM_STRICT=1
CONNECTOR_ALLOW_HOST_MCP_BROKER=0
CONNECTOR_MICROVM_REQUIRE_HEARTBEAT=1

# T2 / T4 / T6 — kernel transparent egress + durable replay + partner HAL
CONNECTOR_TRANSPARENT_EGRESS=1
CONNECTOR_TRANSPARENT_EGRESS_KERNEL=1
CONNECTOR_EGRESS_PROXY_PORT=19090
CONNECTOR_EGRESS_TLS_TERMINATE=1
CONNECTOR_MISSION_ABANDON_STALE_PENDING=1
CONNECTOR_CONP_LAB_ECHO=0
CONNECTOR_CONP_SIL_REQUIRE=1
# Lab measured assets (override with real Firecracker images in prod)
CONNECTOR_MICROVM_KERNEL=platform/lab/microvm-assets/vmlinux.lab
CONNECTOR_MICROVM_ROOTFS=platform/lab/microvm-assets/rootfs.lab.ext4
# Partner HAL (example): CONNECTOR_CONP_PARTNER_HAL=ros|modbus|mqtt|tcp
# CONNECTOR_CONP_PARTNER_HAL_URL=tcp://127.0.0.1:9090
# SIL partner: CONNECTOR_CONP_SIL_PARTNER_URL=tcp://127.0.0.1:7448
# Operator should set: CONNECTOR_EGRESS_CHANNEL_HMAC_KEY=<long-random>
# Operator should set: CONNECTOR_CONP_SIL_HMAC_KEY=<long-random>
# Operator must set real measured assets before tool effects:
# CONNECTOR_MICROVM_KERNEL=/path/to/vmlinux
# CONNECTOR_MICROVM_ROOTFS=/path/to/rootfs.ext4
# CONNECTOR_MICROVM_KERNEL_SHA256=...
# CONNECTOR_MICROVM_ROOTFS_SHA256=...
# CONNECTOR_VSOCK_HMAC_KEY=<long-random>
# CONNECTOR_AUDIT_HMAC_KEY=<64+ hex>
# CONNECTOR_CFNI_SECRET=<secret>
# CONNECTOR_CAGE_CAP_SECRET=<secret>

# Court/military: never set CLAIM_MILITARY_COURT=1 until verdict.json says met=true
# CLAIM_MILITARY_COURT=0
