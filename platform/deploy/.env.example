# Bootstrap-only template (Phase 0.7 — CONNECTOR_OS_ROADMAP.md §2D.4).
# Copy to platform/deploy/.env for local experiments. Do not commit .env.
#
# Secrets (Stripe, JWT, LLM keys, plugin admin tokens, etc.) belong in the
# dashboard Secret Vault after install — not in flat env files.
#
# Optional TLS helper: platform/deploy/ssl-setup.sh (verify | nginx) still
# reads DOMAIN, LICENSE_DOMAIN, ACME_EMAIL from the same .env — add those
# keys yourself when you use that script; they are intentionally omitted here.

# ── Kernel bootstrap (allowed small surface) ─────────────────────────────────
CONNECTOR_PRESET=local
CONNECTOR_HOST=0.0.0.0
CONNECTOR_PORT=9090
CONNECTOR_DATA_DIR=./data

# Optional: license material / server URL used during activation (not a secret vault replacement)
# CONNECTOR_LICENSE=
# CONNECTOR_LICENSE_SERVER=https://license.connector.dev
# HMAC secret required to mint/verify signed lic_<tier>_<nonce>.<hmac> keys
# CONNECTOR_LICENSE_HMAC_KEY=

# Scrape auth for /metrics (required in production-like environments)
# CONNECTOR_METRICS_TOKEN=

# MCP / plugin / webhook egress
# CONNECTOR_MCP_EGRESS_ENFORCE=1
# CONNECTOR_MCP_EGRESS_ALLOWLIST=mcp.example.com

# Lab-only host python for notebooks (disabled by default; never on in prod without ALLOW_IN_PROD)
# CONNECTOR_NOTEBOOK_HOST_EXEC=0
# CONNECTOR_NOTEBOOK_HOST_EXEC_ALLOW_IN_PROD=0

# Receipt HMAC (falls back to CONNECTOR_JWT_SECRET)
# CONNECTOR_RECEIPT_HMAC_KEY=

# ── Control-plane (docker-compose.control-plane.yml) ─────────────────────────
# Copy below block to .env, fill in real values, then:
#   docker compose -f docker-compose.control-plane.yml up -d

# Admin key protecting /api/v1/admin/* and /api/v1/surveillance/*
CONNECTOR_LICENSE_ADMIN_KEY=change-me-to-a-long-random-secret

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_COMMUNITY=price_...
STRIPE_PRICE_STARTUP=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# Email (dunning recovery, welcome emails)
SENDGRID_API_KEY=SG....
CONNECTOR_FROM_EMAIL=noreply@connector.dev

# Public domains (must match DNS)
PORTAL_DOMAIN=connector.dev
PLAYGROUND_DOMAIN=try.connector.dev
CONNECTOR_PUBLIC_URL=https://connector.dev
PLAYGROUND_PUBLIC_URL=https://try.connector.dev
ACME_EMAIL=admin@connector.dev

# CIDR range(s) that can access /admin — your office VPN / tailscale subnet
ADMIN_CIDR=10.0.0.0/8

# ── Cloudflare (DNS, WAF, SSL automation) ─────────────────────────────────────
# Get API token from dash.cloudflare.com/profile/api-tokens
# Required permissions: Zone:Read, DNS:Edit, SSL:Edit, Firewall:Edit, WAF:Edit, Cache:Purge
# MUST be scoped to cnktros.com zone only (NOT "All zones")
CLOUDFLARE_API_TOKEN=REPLACE_ME_cf_api_token

# Get Zone ID from dash.cloudflare.com → cnktros.com → right sidebar
CLOUDFLARE_ZONE_ID=your_zone_id_here
