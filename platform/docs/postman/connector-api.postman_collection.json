{
  "info": {
    "name": "Connector Platform API",
    "description": "Complete API collection for the Connector Platform - Enterprise AI Agent Operating System.\n\nIncludes V1 and V2 APIs for agents, memory, tools, sessions, audit, and compliance.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "connector-platform-api-v1"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "agent_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "session_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "memory_cid",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health/live",
              "host": ["{{base_url}}"],
              "path": ["health", "live"]
            },
            "description": "Kubernetes liveness probe - returns 200 if process is alive"
          }
        },
        {
          "name": "Readiness Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health/ready",
              "host": ["{{base_url}}"],
              "path": ["health", "ready"]
            },
            "description": "Kubernetes readiness probe - returns 200 if ready to accept traffic"
          }
        },
        {
          "name": "Startup Probe",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/health/startup",
              "host": ["{{base_url}}"],
              "path": ["health", "startup"]
            },
            "description": "Kubernetes startup probe - returns 200 when boot sequence is complete"
          }
        }
      ]
    },
    {
      "name": "V2 API",
      "description": "Simplified V2 API with consistent patterns and smart defaults",
      "item": [
        {
          "name": "Agents",
          "item": [
            {
              "name": "Create Agent",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    var jsonData = pm.response.json();",
                      "    if (jsonData.ok && jsonData.data) {",
                      "        pm.collectionVariables.set('agent_id', jsonData.data.id);",
                      "    }",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {"key": "Content-Type", "value": "application/json"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"my-agent\",\n  \"namespace\": \"/m/my-agent\",\n  \"model\": \"gpt-4o\",\n  \"description\": \"My first agent\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v2/agents",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v2", "agents"]
                },
                "description": "Create a new agent"
              }
            },
            {
              "name": "List Agents",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v2/agents?limit=100",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v2", "agents"],
                  "query": [
                    {"key": "limit", "value": "100"},
                    {"key": "status", "value": "", "disabled": true},
                    {"key": "namespace", "value": "", "disabled": true}
                  ]
                },
                "description": "List all agents with optional filters"
              }
            },
            {
              "name": "Get Agent",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v2/agents/{{agent_id}}",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v2", "agents", "{{agent_id}}"]
                },
                "description": "Get agent details by ID"
              }
            },
            {
              "name": "Start Agent",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v2/agents/{{agent_id}}/start",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v2", "agents", "{{agent_id}}", "start"]
                },
                "description": "Start an agent"
              }
            },
            {
              "name": "Stop Agent",
              "request": {
                "method": "POST",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v2/agents/{{agent_id}}/stop",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v2", "agents", "{{agent_id}}", "stop"]
                },
                "description": "Stop an agent"
              }
            },
            {
              "name": "Get Agent Health",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v2/agents/{{agent_id}}/health",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v2", "agents", "{{agent_id}}", "health"]
                },
                "description": "Get agent health score (KECS)"
              }
            }
          ]
        },
        {
          "name": "Memory",
          "item": [
            {
              "name": "Write Memory",
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "exec": [
                      "if (pm.response.code === 200) {",
                      "    var jsonData = pm.response.json();",
                      "    if (jsonData.ok && jsonData.data) {",
                      "        pm.collectionVariables.set('memory_cid', jsonData.data.cid);",
                      "    }",
                      "}"
                    ],
                    "type": "text/javascript"
                  }
                }
              ],
              "request": {
                "method": "POST",
                "header": [
                  {"key": "Content-Type", "value": "application/json"}
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"agent_id\": \"{{agent_id}}\",\n  \"content\": {\n    \"type\": \"note\",\n    \"text\": \"Remember this important fact\",\n    \"importance\": \"high\"\n  },\n  \"tags\": [\"important\", \"fact\"],\n  \"summary\": \"An important note\"\n}"
                },
                "url": {
                  "raw": "{{base_url}}/api/v2/memory",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v2", "memory"]
                },
                "description": "Write memory to an agent"
              }
            },
            {
              "name": "List Memory",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v2/memory?agent_id={{agent_id}}&limit=100",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v2", "memory"],
                  "query": [
                    {"key": "agent_id", "value": "{{agent_id}}"},
                    {"key": "limit", "value": "100"},
                    {"key": "namespace", "value": "", "disabled": true}
                  ]
                },
                "description": "List memory entries"
              }
            },
            {
              "name": "Get Memory",
              "request": {
                "method": "GET",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v2/memory/{{memory_cid}}",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v2", "memory", "{{memory_cid}}"]
                },
                "description": "Get memory by CID with content"
              }
            },
            {
              "name": "Delete Memory",
              "request": {
                "method": "DELETE",
                "header": [],
                "url": {
                  "raw": "{{base_url}}/api/v2/memory/{{memory_cid}}",
                  "host": ["{{base_url}}"],
                  "path": ["api", "v2", "memory", "{{memory_cid}}"]
                },
                "description": "Delete memory by CID"
              }
            }
          ]
        },
