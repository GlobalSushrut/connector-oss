{
  "apiVersion": "connector.ai/v1",
  "kind": "Intelligence",
  "metadata": {
    "name": "warehouse-picker"
  },
  "spec": {
    "purpose": "pick and place in aisle B",
    "class": "robotics",
    "parameters": {
      "model": "gpt-4o",
      "namespace": "m/warehouse",
      "tags": ["demo", "robotics"]
    },
    "skills": [
      {
        "id": "grasp",
        "kind": "conp",
        "capability": "actuator.gripper",
        "risk": "high",
        "requires_hitl": true,
        "allowed_targets": ["machine:*"],
        "params_schema": {
          "type": "object",
          "properties": { "force": { "type": "number" } }
        }
      },
      {
        "id": "move",
        "kind": "conp",
        "capability": "machine.move_axis",
        "risk": "high",
        "requires_hitl": true
      }
    ],
    "knowledge": [
      {
        "title": "speed limit",
        "content": "Never exceed 2m/s in aisle B."
      },
      {
        "title": "ops notes",
        "document": "Bay doors require human approval. Keep gripper force under 40N near humans."
      }
    ],
    "limitations": {
      "network_default": "deny",
      "denied_operations": ["ambient_shell", "modify_contract"],
      "hitl": "tool",
      "forensic": "standard"
    },
    "portals": [
      {
        "id": "arm",
        "type": "machine",
        "entity_id": "machine:arm-1",
        "capabilities": ["actuator.gripper", "machine.move_axis"]
      }
    ],
    "rules": [
      {
        "id": "bay-doors",
        "effect": "ask",
        "when_risk": ["high"],
        "text": "Bay doors need HITL"
      },
      {
        "id": "note-speed",
        "effect": "note",
        "text": "Cap speed 2m/s"
      }
    ],
    "harden": true,
    "activate": true
  }
}
