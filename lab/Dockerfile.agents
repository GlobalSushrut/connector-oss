FROM python:3.12-slim

RUN pip install --no-cache-dir httpx fastapi uvicorn[standard]

WORKDIR /app
COPY agent_runner.py .

EXPOSE 4200

HEALTHCHECK --interval=10s --timeout=5s --retries=12 --start-period=10s \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:4200/health').read()" || exit 1

CMD ["uvicorn", "agent_runner:app", "--host", "0.0.0.0", "--port", "4200", "--log-level", "info"]
