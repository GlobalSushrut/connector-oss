FROM python:3.12-slim-bookworm

WORKDIR /app
COPY runner/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY runner/lab_runner ./lab_runner
COPY scenarios ./scenarios
COPY schemas ./schemas

ENV PYTHONUNBUFFERED=1
ENV SCENARIOS_DIR=/app/scenarios

# Default: full lab scenario run (override with e.g. `python -m lab_runner.smoke`)
CMD ["python", "-m", "lab_runner.lab_run", "--only", "all"]
