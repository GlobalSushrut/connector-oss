# syntax=docker/dockerfile:1.6
# TraceTramp Production Dockerfile
# Multi-stage build for minimal image size
#
# `connector-report-pdf` is a path dep to ../../oss/... (see Cargo.toml). The compose
# build passes `additional_contexts: oss` so COPY --from=oss populates /oss.

# Stage 1: Builder (lockfile v4 + workspace deps need current stable; 1.88+ per crate MSRV)
FROM rust:1.88-slim-bookworm AS builder

# Install build dependencies
RUN apt-get update && apt-get install -y \
    pkg-config \
    libssl-dev \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy manifests first for layer caching
COPY Cargo.toml Cargo.lock ./

# Path dependency ../../oss/connector/crates/connector-report-pdf → /oss/...
COPY --from=oss . /oss
# Path dependency ../../platform/plugin-handshake (compose: additional_contexts.platform)
COPY --from=platform . /platform

# Create dummy main.rs to build dependencies
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release && rm -rf src

# Copy actual source code
COPY src ./src
COPY migrations ./migrations

# Build application
RUN touch src/main.rs
RUN cargo build --release --bin tracetramp

# Stage 2: Runtime
FROM debian:bookworm-slim AS runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y \
    ca-certificates \
    curl \
    libssl3 \
    postgresql-client \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy binary from builder
COPY --from=builder /app/target/release/tracetramp /usr/local/bin/tracetramp

# Copy migrations
COPY --from=builder /app/migrations ./migrations

# Create non-root user
RUN useradd -m -u 1000 tracetramp && chown -R tracetramp:tracetramp /app
USER tracetramp

# Expose ports
EXPOSE 9741 9742

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
    CMD curl -f http://localhost:9741/health || exit 1

# Run migrations and start
CMD ["tracetramp"]
