{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://connector.local/schemas/lab-run-report.json",
  "title": "Advanced lab scenario result (§5.5)",
  "type": "object",
  "required": [
    "scenario_id",
    "kind",
    "started_at",
    "finished_at",
    "trace_id",
    "http_status",
    "outcome",
    "response_sentence"
  ],
  "properties": {
    "scenario_id": { "type": "string" },
    "kind": { "type": "string", "enum": ["action_sim", "attack_sim"] },
    "owasp": { "type": ["string", "null"] },
    "attack_class": { "type": ["string", "null"] },
    "description": { "type": ["string", "null"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "trace_id": { "type": "string" },
    "request_id": { "type": "string" },
    "http_status": { "type": "integer" },
    "outcome": {
      "type": "string",
      "enum": ["allow", "block", "redact", "hitl", "error", "throttle", "unknown"]
    },
    "response_sentence": { "type": "string" },
    "decision_pointer": { "type": ["string", "null"] },
    "action_trace_len": { "type": "integer" },
    "block_flags_len": { "type": "integer" },
    "witness_correlation_ok": { "type": ["boolean", "null"] },
    "errors": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
