# ── Real AI Infrastructure Lab — Environment Variables ──────────────────────
# Copy to advanced-lab/.env and fill in your keys.
#
# cp advanced-lab/.env.example advanced-lab/.env

# ── DeepSeek API (real LLM — lab primary upstream, not “OpenAI”) ─────────────
# Get your key at: https://platform.deepseek.com/api-keys
# TraceTramp maps these to its upstream env; traffic is DeepSeek cloud, not OpenAI.
# Do not commit real keys. Compose requires this to be set (no mock default).
DEEPSEEK_API_KEY=


# DeepSeek API base (official DeepSeek HTTPS API)
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# ── Lab tokens (static for demo — rotate in production) ─────────────────────
TRACETRAMP_ADMIN_TOKEN=lab_admin_token_static
WITNESSCTL_ADMIN_TOKEN=lab_admin_token_static

# ── Service URLs (defaults match docker-compose port mappings) ───────────────
TRACETRAMP_ADMIN_URL=http://127.0.0.1:19742
TRACETRAMP_DATA_URL=http://127.0.0.1:19741
WITNESSCTL_URL=http://127.0.0.1:17443
# Lab runner (Compose service "openfang"): http://127.0.0.1:14200 — Python → TraceTramp.
# Upstream AIOS (Rust): https://github.com/RightNow-AI/openfang · https://openfang.sh/docs/getting-started
OPENFANG_URL=http://127.0.0.1:14200
