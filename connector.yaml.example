# Normal use: skip this file — with no CONNECTOR_PRESET / CONNECTOR_ENV / license env, the binary defaults to preset `local` (development + CONNECTOR_DEV_MODE); see CONNECTOR_OS_ROADMAP.md §3. Set CONNECTOR_PRESET explicitly when you need another mode.
#
#   CONNECTOR_PRESET=local ./target/debug/connector-platform
#
# Enterprise (production):
#   CONNECTOR_CONFIG_STRICT=1          — fail boot on invalid YAML or unknown CONNECTOR_PRESET
#   CONNECTOR_ENFORCE_PRODUCTION_PRESETS=1 — reject dev presets (local, ci, …) when CONNECTOR_ENV=production
#   CONNECTOR_PRODUCTION_REJECT_DEV_MODE=1 — fail boot when CONNECTOR_ENV=production and CONNECTOR_DEV_MODE is still set (systemd foot-gun; dev auth bypass is already OFF in prod — see runtime_control)
#   GET /api/v1/plugins/status → phase_5_operator.process_env_operator_display_line — canonical process/hygiene one-liner (also top-level on connectorctl status --json when set)
# Max file size: 512 KiB (hard limit).
# Never commit secrets; use your secret manager / env vars for keys.
#
# Config search order:
#   1) CONNECTOR_CONFIG_FILE=/path/to/file.yaml
#   2) ./connector.yaml
#   3) ./.connector/connector.yaml

version: 1

# Optional: same as env CONNECTOR_PRESET. IDs:
#   local, local-live-llm, docker-local, ci, preview, staging, production,
#   airgap, defense-strict, multi-tenant, plugin-workbench, edge-satellite, ultimate-free
preset: local

connector:
  host: "0.0.0.0"
  port: 9091
  # public_url: "http://localhost:9091"
  # protocol_port: 9092
  # ui_rpc_port: 9093
  # data_dir: "./data"
  # engine_storage: "sqlite:./data/engine.db"
  # kernel_storage: "redb:./data/kernel.redb"
  # runtime_mode: "development"   # maps to CONNECTOR_ENV
  # cage_tld: "cnktros"            # CONNECTOR_CAGE_TLD — internal plugin hostnames (<slug>.<tld>)
  # open_auth: true                # CONNECTOR_ULTIMATE_FREE=1 — no login (production-safe free tier)

# Optional: which first-party plugins are part of this deployment (ids: devguard, tracetramp, witnessctl).
# When present and CONNECTOR_PLUGINS_ENABLED is unset, a comma list is derived (skip entries with enabled: false).
# lab_compose is optional metadata for lab tooling; when unset in the environment, maps to CONNECTOR_PLUGIN_<ID>_LAB_COMPOSE.
# plugins:
#   - id: tracetramp
#     lab_compose: lab/docker-compose.premium-lab.yml
#   - id: witnessctl
#   - id: devguard
#     enabled: false

# ── Optional env: connector-supervisor + plugin dev (Phase 5.10, not YAML keys) ──
# Background `connectorctl start` without systemd — restart after non-zero child exit:
#   CONNECTOR_SUPERVISOR_RESTART_MAX=3       # 0 = off; max 50 extra respawns
#   CONNECTOR_SUPERVISOR_RESTART_BASE_MS=1000
#   CONNECTOR_SUPERVISOR_RESTART_CAP_MS=60000
#   CONNECTOR_SUPERVISOR_LOGS=1              # stream prefixed logs; log restart backoff sleeps
#   CONNECTOR_SUPERVISOR_NODE_CRASH_PLUGIN_ID=kernel/node   # optional; non-success exits POST …/plugin-crash-recovery/record for this id (Phase 5.10.6)
# `connectorctl plugin run --dev` uses `--retry-max` / `--retry-base-ms` (see `connectorctl plugin help`).
# Crash recovery POSTs use CONNECTOR_API_URL and CONNECTOR_API_KEY (or dev-token) when set.
#
# Tier idle suspend (Phase 5.4.3) — kernel demotes Warm/Hot → Cold after no tier-touch:
#   CONNECTOR_PLUGIN_IDLE_SUSPEND_AFTER_MS=900000   # e.g. 15 minutes; 0 or unset = off
#                                            # microVM: also emitted as connector.plugin_idle_suspend_after_ms on guest cmdline (vm-agent logs; Phase 5.4.3 guest suspend remainder)
#   Operator view: `connectorctl tier show` (GET …/plugin-tier-scheduler); `connectorctl status --json` → `tier_scheduler`; `connectorctl doctor --json` → `doctor_extensions.tier_scheduler`
#
# Docker lab egress (Phase 5.7.2 partial — connector-plugin-runtime `docker run`):
#   CONNECTOR_PLUGIN_RUN_BACKEND=docker_lab         # connectorctl plugin run --dev uses Docker (else host subprocess/microvm)
#   CONNECTOR_PLUGIN_RUN_BACKEND=microvm            # connectorctl plugin run --dev uses connector-microvm backend
#   CONNECTOR_DOCKER_LAB_IMAGE=alpine:3.20          # optional; image must match plugin entrypoint (e.g. glibc vs musl)
#   CONNECTOR_DOCKER_LAB_EGRESS=unrestricted        # default
#   CONNECTOR_DOCKER_LAB_EGRESS=deny_all            # adds --network none
#   CONNECTOR_DOCKER_LAB_EGRESS=allowlist_strict    # --network none when manifest has no network.outbound caps
#   CONNECTOR_DOCKER_LAB_EGRESS_ENFORCE=iptables      # Linux: DOCKER-USER allowlist (foreground or detached; detached uses background docker wait to flush rules)
#   CONNECTOR_DOCKER_LAB_ALLOW_RESOLVER_DNS=1         # with iptables enforce: allow UDP/TCP 53 to /etc/resolv.conf nameservers (0=off)
#
# Subprocess prctl (Phase 5.9 partial — connector-plugin-runtime Linux host subprocess only):
#   CONNECTOR_PLUGIN_SUBPROCESS_NO_NEW_PRIVS=1        # PR_SET_NO_NEW_PRIVS before plugin main
#   CONNECTOR_PLUGIN_SUBPROCESS_NOT_DUMPABLE=1        # PR_SET_DUMPABLE 0 (no core dumps)
#   CONNECTOR_PLUGIN_SUBPROCESS_SECCOMP=strict        # PR_SET_SECCOMP strict mode (read/write/_exit/sigreturn only)
#   CONNECTOR_PLUGIN_SUBPROCESS_SECCOMP=deny_dangerous # x86_64/aarch64 Linux BPF filter: blocks keyring/bpf/perf/userfaultfd/clone3/unshare
#   CONNECTOR_PLUGIN_SUBPROCESS_SECCOMP=network_deny   # x86_64/aarch64 Linux BPF filter: denies socket/connect/accept/bind/listen/send/recv syscalls
#   CONNECTOR_PLUGIN_SUBPROCESS_SECCOMP=network_ingress_deny # x86_64/aarch64 Linux BPF filter: deny bind/listen/accept, allow outbound client connects
#   CONNECTOR_PLUGIN_SUBPROCESS_SECCOMP_INTENT=safe_default  # preferred operator control; maps to deny_dangerous
#   CONNECTOR_PLUGIN_SUBPROCESS_SECCOMP_INTENT=no_network    # maps to network_deny
#   CONNECTOR_PLUGIN_SUBPROCESS_SECCOMP_INTENT=no_ingress    # maps to network_ingress_deny
#   CONNECTOR_PLUGIN_SUBPROCESS_SECCOMP_INTENT=strict        # maps to strict; intent takes precedence over _SECCOMP
#
# Subprocess cgroup v2 (Phase 5.8 partial — Linux only; requires writable delegated parent slice):
#   CONNECTOR_PLUGIN_SUBPROCESS_CGROUP_PARENT=/sys/fs/cgroup/user.slice/.../connector-plugins.slice
#   CONNECTOR_PLUGIN_SUBPROCESS_MEMORY_MAX_BYTES=268435456   # optional memory.max (bytes)
#   CONNECTOR_PLUGIN_SUBPROCESS_CPU_PCT=50                   # optional cpu.max quota vs 100ms period
#   CONNECTOR_PLUGIN_SUBPROCESS_IO_MAX="8:0 rbps=1048576 wbps=1048576,8:16 riops=500 wiops=250"
#                                                    # optional io.max lines (device major:minor + rbps/wbps/riops/wiops)
#   CONNECTOR_PLUGIN_SUBPROCESS_IO_MAX_AUTO=1       # optional fallback when IO_MAX is unset: derive device from workspace/cwd mount
#   CONNECTOR_PLUGIN_SUBPROCESS_IO_MAX_AUTO_RBPS=1048576
#   CONNECTOR_PLUGIN_SUBPROCESS_IO_MAX_AUTO_WBPS=1048576
#   CONNECTOR_PLUGIN_SUBPROCESS_IO_MAX_AUTO_RIOPS=500
#   CONNECTOR_PLUGIN_SUBPROCESS_IO_MAX_AUTO_WIOPS=250
#   CONNECTOR_PLUGIN_SUBPROCESS_WORKSPACE_MAX_BYTES=1073741824 # optional pre-spawn writable workspace cap (bytes)
#   CONNECTOR_PLUGIN_SUBPROCESS_WORKSPACE_MAX_ENFORCE=1        # fail spawn when workspace size already exceeds cap
#   CONNECTOR_PLUGIN_SUBPROCESS_CGROUP_ENFORCE=1             # fail spawn if attach fails (default: best-effort)
# Tier scheduler + cgroup (Phase 5.4.3 sample — Linux):
#   CONNECTOR_PLUGIN_TIER_CGROUP_SCAN=1                      # add utilization.cgroup_v2 from runner-* children
#   CONNECTOR_PLUGIN_TIER_CGROUP_IDLE_DEMOTE=1               # Linux + CGROUP_PARENT: Warm/Hot → Cold before full idle window if runner-<plugin>-* CPU growth stays low (needs CONNECTOR_PLUGIN_IDLE_SUSPEND_AFTER_MS > 0)
#   CONNECTOR_PLUGIN_TIER_CGROUP_DEMOTE_MAX_USEC_PER_WALL_SEC=20000  # threshold: avg usage_usec delta / wall-clock second below this → demote (default 20000)
#   CONNECTOR_PLUGIN_TIER_CGROUP_DEMOTE_MIN_IDLE_MS=30000    # min ms since tier-touch before cgroup demotion can fire
#   CONNECTOR_PLUGIN_TIER_CGROUP_DEMOTE_SAMPLE_GAP_MS=10000    # min ms between cgroup samples for rate estimate
#
# microVM runtime assets (Phase 5.3):
#   CONNECTOR_FIRECRACKER_BIN=/opt/connector/vendor/firecracker/linux/x86_64/firecracker
#   CONNECTOR_MICROVM_KERNEL=/opt/connector/vendor/microvm/linux/x86_64/vmlinux
#   CONNECTOR_MICROVM_ROOTFS=/opt/connector/vendor/microvm/linux/x86_64/rootfs.ext4
#   CONNECTOR_MICROVM_STATE_DIR=/var/lib/connector/microvm
#   CONNECTOR_VM_AGENT_GUEST_PATH=/sbin/connector-vm-agent
#   CONNECTOR_MICROVM_EGRESS_MODE=deny_all       # default fail-closed: rejects microVM spawn when outbound allowlist is requested
#   CONNECTOR_MICROVM_EGRESS_MODE=allowlist_strict # requires valid non-wildcard network.outbound entries for microVM spawn
#   CONNECTOR_MICROVM_EGRESS_ENFORCE=iptables    # Linux Firecracker: TAP + ip= + optional ULA + ip6tables FORWARD TCPv6 + MASQUERADE (root/CAP_NET_ADMIN; host must have routable IPv6 when caps resolve to AAAA)
#   CONNECTOR_MICROVM_ALLOW_RESOLVER_DNS=1       # with iptables enforce: allow DNS to /etc/resolv.conf IPv4 nameservers (falls back to CONNECTOR_DOCKER_LAB_ALLOW_RESOLVER_DNS)
#   CONNECTOR_MICROVM_GUEST_IFACE=eth0           # optional; with AAAA/TAPv6 egress, passed as connector.microvm_guest_iface for vm-agent `ip -6 addr` (default eth0)
#   CONNECTOR_MICROVM_EGRESS_ENFORCE_REQUIRED=1  # fail-closed when _EGRESS_ENFORCE is requested but unavailable on current host path (e.g. Windows/WSL bridge)
#                                            # runtime arms a PID-exit watcher for best-effort iptables/TAP teardown; receipt includes cleanup_hint
#   CONNECTOR_MACOS_VZ_SIDECAR=/opt/connector/vendor/firecracker/darwin/arm64/connector-microvm-macos
#   CONNECTOR_WSL_DISTRO=Ubuntu                 # Windows host: WSL2 distro used for Firecracker + JSON launcher bridge (Phase 5.3.7)
#   CONNECTOR_MICROVM_WSL_STATE_DIR=/tmp/connector-microvm   # Paths inside WSL for API socket, logs, vsock (avoid Windows FS for UDS)
#   CONNECTOR_MICROVM_TIER_STATE_FILE=/var/lib/connector/microvm-tier-state.json  # optional; connector-platform writes vendor/slug→cold|warm for vsock tier_signal when CONNECTOR_MICROVM_VSOCK_TIER_SIGNAL=1 on plugin-runtime
#   CONNECTOR_MICROVM_TIER_STATE_SYNC_MS=2000                 # how often the kernel refreshes that file (500–120000)
#   CONNECTOR_WSL_PYTHON=python3                # Interpreter inside the distro for connector-microvm-wsl-launch.py
#   CONNECTOR_WSL_LAUNCHER=                     # Optional absolute path to a custom launcher script (else embedded copy in %TEMP%)
#   CONNECTOR_WSL_EGRESS_APPLY=                 # optional: path to connector-microvm-wsl-egress-apply.py inside Windows (else %TEMP% copy; Phase 5.7.2 WSL2 iptables TAP)
# Condo guest heartbeat gate (Phase 5.5.2 runtime bridge):
#   CONNECTOR_CONDO_GUEST_HEARTBEAT_TTL_MS=60000  # microvm_pool transition requires fresh guest heartbeat within TTL
#   CONNECTOR_CONDO_GUEST_HEARTBEAT_TOKEN=...     # scoped bearer token accepted by /plugin-condos/guest-heartbeat
# microVM guest heartbeat source (connector-vm-agent; boot args/env):
#   CONNECTOR_CONDO_ID=<condo_id>                 # emits POST /api/v1/kernel/plugin-condos/guest-heartbeat
#   CONNECTOR_CONDO_GUEST_ID=<guest_id>           # optional guest instance id
#   CONNECTOR_CONDO_TARGET_POOL=<cell>/<shard>    # heartbeat pool identity expected by placement gate
#   CONNECTOR_CONDO_GUEST_HEARTBEAT_URL=...       # optional explicit heartbeat URL (else derived from CONNECTOR_API_URL)
#
# Supervisee pattern catalog: `connectorctl supervisor inventory` or GET /api/v1/kernel/supervisor/inventory
#
# Condo placement (Phase 5.5.2 scaffold): POST /api/v1/kernel/plugin-condos/placement { condo_id, state, target_pool?, notes? }
#   state ∈ unassigned | microvm_pending | microvm_pool | reserved
