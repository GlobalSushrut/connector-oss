# ── The only required variable (Connector Cloud / hosted) ─────────────────────
# Everything else is inferred from the URL: auth, host, namespace, config.
ENGRAM_URL=engram://cpk_live_acme1234@engram.acme.com/acme/support-agent

# ── Server (self-hosted operators only) ───────────────────────────────────────
DATABASE_URL=postgres://engram:engram@localhost:5432/engram
CONNECTOR_BASE_URL=http://localhost:8080
CONNECTOR_API_KEY=cpk_live_...
PORT=9092
METRICS_PORT=9093

# ── Fallback if ENGRAM_URL is not set (self-hosted, separate env vars) ─────────
# ENGRAM_NAMESPACE=acme/support-agent
# ENGRAM_API_KEY=cpk_live_...
# ENGRAM_HOST=localhost:9092

# ── Optional tuning ────────────────────────────────────────────────────────────
# ENTROPY_SWEEP_SECS=300       # how often the background entropy sweep runs
# REQUEST_TIMEOUT_SECS=30      # HTTP request timeout
# LOG_FORMAT=json              # "json" (default) or "pretty" for local dev
# RUST_LOG=info,engram=debug
