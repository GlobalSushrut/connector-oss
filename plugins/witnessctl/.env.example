WITNESSCTL_PORT=7443
WITNESSCTL_DATABASE_URL=postgres://postgres:postgres@localhost:5432/witnessctl
# Reserved for future `witnessctl watch` pub/sub streaming mode.
# Not required for core capture/proxy/report flows today.
WITNESSCTL_REDIS_URL=redis://127.0.0.1:6379

CONNECTOR_BASE_URL=http://localhost:9735
CONNECTOR_API_KEY=replace_with_connector_api_key
CONNECTOR_LICENSE_TIER=free
WITNESSCTL_REQUESTED_AGENTS=1
WITNESSCTL_CAGE_MODE=false
WITNESSCTL_ROUTE_PROFILE=standard
WITNESSCTL_ROUTE_ALLOWLIST=
WITNESSCTL_METHOD_ALLOWLIST=GET,POST,PUT,PATCH,DELETE,HEAD,OPTIONS
WITNESSCTL_PATH_PREFIX_ALLOWLIST=/
WITNESSCTL_WATCHDOG_INTERVAL_SECS=15
WITNESSCTL_FIREWALL_TIMEOUT_MS=200
WITNESSCTL_STRICT_MODE=false
WITNESSCTL_DUAL_ATTESTOR_REQUIRED=false
WITNESSCTL_DUAL_ATTESTOR_FRAMEWORKS=hipaa,soc2,pci_dss
WITNESSCTL_TSA_URL=
WITNESSCTL_TSA_STRICT_VERIFY=false
WITNESSCTL_TSA_CA_FILE=
WITNESSCTL_TSA_REQUIRED_FRAMEWORKS=hipaa,soc2,pci_dss
WITNESSCTL_WORM_DIR=
WITNESSCTL_WORM_HTTP_URL=
WITNESSCTL_WORM_HTTP_BEARER=
# Comma-separated custody node base URLs (each must expose POST /api/v1/custody/replicate).
WITNESSCTL_CUSTODY_REPLICAS=http://127.0.0.1:7444
WITNESSCTL_CUSTODY_NODE_SECRET=
WITNESSCTL_CUSTODY_NODE_ID=witnessctl-primary
WITNESSCTL_CUSTODY_NODE_REGION=us-east-1
WITNESSCTL_CUSTODY_NODE_PORT=7444
WITNESSCTL_ATTESTOR_JWT_SECRET=
WITNESSCTL_ATTESTOR_JWT_ISSUER=
WITNESSCTL_ATTESTOR_JWT_AUDIENCE=

# Required in all non-demo environments.
# Generate with: `witnessctl setup` for local dev only.
# Production: store in Vault/AWS Secrets Manager/GCP Secret Manager, not in `.env`.
WITNESSCTL_HMAC_SECRET=change-me-in-production

# Sealed evidence bundles: `{session_id}-{ts}.witness` (+ `.witness.json` metadata).
WITNESSCTL_BUNDLE_DIR=./witness-evidence

# TraceTramp async handoff: same value as TraceTramp `TRACETRAMP_WITNESS_HANDOFF_SECRET` (header `X-WitnessCtl-Tracetramp-Handoff-Secret`).
WITNESSCTL_TRACETRAMP_HANDOFF_SECRET=

LOG_FORMAT=text
RUST_LOG=witnessctl=info
