# AgentPassport — Environment Variables

# ── Required ──────────────────────────────────────────────────────
DATABASE_URL=postgres://postgres:postgres@localhost:5432/agentpassport
AGENTPASSPORT_API_KEY=change-me-before-production

# Ed25519 signing key (hex-encoded 32-byte private key)
# Generate with: openssl rand -hex 32
# IMPORTANT: This key signs all verification proofs and attestations.
# Rotate with care — existing proofs verified against the old key will
# require re-verification against the new key.
AGENTPASSPORT_SIGNING_KEY=

# ── Identity ──────────────────────────────────────────────────────
AGENTPASSPORT_INSTANCE_ID=default
AGENTPASSPORT_KEY_ID=key-1
AGENTPASSPORT_ORG_ID=00000000-0000-0000-0000-000000000000

# ── ConnectorOS kernel ────────────────────────────────────────────
CONNECTOR_URL=http://localhost:8080
CONNECTOR_API_KEY=

# ── Network ───────────────────────────────────────────────────────
PORT=8086
METRICS_PORT=9092
REQUEST_TIMEOUT_SECS=30

# ── Background tasks ──────────────────────────────────────────────
# How often to pull trust scores from ConnectorOS (seconds)
TRUST_SYNC_SECS=300

# ── Logging ───────────────────────────────────────────────────────
RUST_LOG=info,agentpassport=debug
# LOG_FORMAT=json   (or "pretty" for local development)
LOG_FORMAT=json

# ── Optional: actor identity for admin actions ────────────────────
# AGENTPASSPORT_ACTOR_DID=did:connector:user:admin@example.com
