# ── Relay: Zero-framework governed agent function runtime ────────────────────
# Copy to .env and fill in your values.

# ── Required ────────────────────────────────────────────────────────────────

# Postgres connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/relay

# ConnectorOS kernel URL (the LLM proxy, admission gate, memory, MCP, audit)
CONNECTOR_BASE_URL=http://localhost:8080

# ConnectorOS admin API key (used by Relay to call Connector internals)
CONNECTOR_API_KEY=cpk_live_...

# ── Relay service ────────────────────────────────────────────────────────────

# Port for Relay API (default: 8087)
PORT=8087

# Port for Prometheus /metrics scrape (default: 9091)
METRICS_PORT=9091

# ── Developer setup (in your existing agent code) ────────────────────────────
#
# These are the ONLY two changes needed in your existing agent code:
#
#   OPENAI_BASE_URL=http://localhost:8087/llm/v1
#   OPENAI_API_KEY=cpk_live_<your-key>
#
# Your agent function then gets, automatically:
#   - Full LLM audit trail
#   - Budget gate enforcement
#   - Admission gate (injection detection, PII redaction)
#   - Multi-provider routing + fallback
#   - Memory context injection via X-Relay-Memory-Context header
#   - Tool injection via X-Relay-Tools header
#   - AgentPassport DID in X-Relay-Agent-Did header

# ── Optional tuning ──────────────────────────────────────────────────────────

# Log level (default: info)
RUST_LOG=relay=info,tower_http=warn

# Health check interval in seconds (default: 30)
# RELAY_HEALTH_INTERVAL_SECS=30

# Async job worker poll interval in seconds (default: 5)
# RELAY_JOB_POLL_SECS=5
