# TraceTramp Configuration

# Server ports
TRACETRAMP_DATA_PLANE_PORT=9741
TRACETRAMP_MANAGEMENT_PLANE_PORT=9742

# Connector API (the underlying Connector kernel)
TRACETRAMP_CONNECTOR_BASE_URL=http://localhost:9735
TRACETRAMP_CONNECTOR_API_KEY=your_connector_api_key_here
TRACETRAMP_JWT_SECRET=replace_with_long_random_secret
CONNECTOR_LICENSE_TIER=free

# Database
TRACETRAMP_DATABASE_URL=postgres://postgres:postgres@localhost:5432/tracetramp

# Redis (optional — omit or set off/disabled/none for PostgreSQL-only approvals)
# TRACETRAMP_REDIS_URL=redis://localhost:6379

# Feature flags
TRACETRAMP_CONTROL_MODE_ENABLED=true
# Optional passthrough “View” lane (off by default). When 1, clients may send X-TraceTramp-Pipeline: view
TRACETRAMP_ALLOW_VIEW_PIPELINE=false
TRACETRAMP_REQUEST_TIMEOUT_SECS=300

# Human-in-the-loop (semi-auto remediation — async; use TUI P or /admin/approvals)
# When true, connector policy "block" becomes 202 pending approval (soft) instead of immediate 403.
TRACETRAMP_SOFT_POLICY_BLOCK=false
# When true, disallowed tool becomes 202 pending approval (soft) instead of immediate 403.
TRACETRAMP_SOFT_TOOL_BLOCK=false
# When true, risk score ≥ 0.7 pauses before the LLM with a pending approval (same queue).
TRACETRAMP_HIGH_RISK_HOLD_BEFORE_LLM=false
# Clients may send: X-TraceTramp-Test-Hold: 1 — pause before LLM for lab/integration tests.

# TUI: approver_id sent to POST /admin/approvals/:id/{approve,reject,quarantine} (audit / SIEM).
TRACETRAMP_TUI_OPERATOR=tui-operator

# WitnessCtl async handoff (optional): base URL of WitnessCtl; shared secret must match `WITNESSCTL_TRACETRAMP_HANDOFF_SECRET`.
TRACETRAMP_WITNESS_HANDOFF_BASE_URL=
TRACETRAMP_WITNESS_HANDOFF_SECRET=

# Logging
LOG_FORMAT=text
RUST_LOG=tracetramp=info,tower_http=info

# ============================================
# Provider Configuration
# ============================================

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_ORG_ID=...

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Azure OpenAI
AZURE_OPENAI_API_KEY=...
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01

# Ollama (local models)
OLLAMA_BASE_URL=http://localhost:11434

# Mistral
MISTRAL_API_KEY=...

# ============================================
# OpenFaaS Configuration
# ============================================
OPENFAAS_GATEWAY_URL=http://localhost:8080
OPENFAAS_USERNAME=admin
OPENFAAS_PASSWORD=...

# ============================================
# Function Execution
# ============================================
FUNCTION_TIMEOUT_SECS=300
FUNCTION_MAX_MEMORY_MB=512

# AWS Lambda (optional)
AWS_REGION=us-east-1
LAMBDA_ROLE_ARN=arn:aws:iam::...:role/lambda-role

# ============================================
# Pipeline / Workflow Settings
# ============================================
WORKFLOW_MAX_EXECUTION_TIME_SECS=3600
WORKFLOW_CHECKPOINT_INTERVAL_SECS=60
WORKFLOW_CONCURRENCY_LIMIT=100

# ============================================
# Advanced Features
# ============================================
# Enable streaming responses
ENABLE_STREAMING=true

# Enable function calling/tool use
ENABLE_TOOLS=true

# Model fallback chain (comma-separated)
FALLBACK_MODELS=gpt-4o,gpt-4o-mini,claude-3-5-sonnet

# Cost optimization (quality threshold 0-1)
COST_OPTIMIZE_THRESHOLD=0.85

# Enable MCP (Model Context Protocol) servers
MCP_SERVERS=http://localhost:3001/sse,http://localhost:3002/sse
